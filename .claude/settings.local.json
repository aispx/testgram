{
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch",
      "Read(**)",
      "Edit(**)",
      "Bash(chmod:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git remote:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(git *:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(docker:*)",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(find:*)",
      "Bash(/root/testgram/build/docker/*.sh)",
      "Bash(/root/testgram/CLAUDE.md:*)",
      "Bash(/root/testgram/docs/CALLS_SETUP.md:*)",
      "Bash(./1.build-messenger-command-server.sh)",
      "WebFetch(domain:core.telegram.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gitlab.com)",
      "WebFetch(domain:docker.com)",
      "Skill(schema-jppgr-am)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(echo \"$input\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('command',''))\" 2>/dev/null); if echo \"$cmd\" | grep -qE '(docker system prune|rm -rf /|dropDatabase)'; then echo 'BLOCKED: требует явного подтверждения' >&2; exit 2; fi; echo \"$input\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); file=$(echo \"$input\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('path',''))\" 2>/dev/null); if echo \"$file\" | grep -q '\\.cs$'; then grep -qE '\\b(192\\.168\\.|10\\.0\\.)' \"$file\" 2>/dev/null && echo \"WARNING: hardcoded IP в $file\" >&2; fi",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "sessions": {
    "save": true
  },
  "disabledMcpjsonServers": [
    "claude-flow"
  ]
}
