# TestGram Bot Configuration
# Copy this file to .env and fill in your values
#
# This bot sends TestGram login codes to the Telegram account that linked the
# phone number through /start. Each Telegram account can link up to 2 numbers.

# ========================
# REQUIRED CONFIGURATION
# ========================

# Bot Token from @BotFather (format: 123456789:ABCdefGhiJklmnopqrSTUvwxyz)
BOT_TOKEN=your_bot_token_here

# Multiple bots (optional)
# You can run several bots at once by adding BOT_TOKEN1, BOT_TOKEN2, ...
# Running a single bot is fine - just leave the extra tokens unset.
# Each user receives login codes through the same bot they linked their
# number with, so the bots do not interfere with each other.
# BOT_TOKEN1=second_bot_token_here
# BOT_TOKEN2=third_bot_token_here

# ========================
# OPTIONAL CONFIGURATION
# ========================

# Database path (default is fine)
# Stores Telegram-user -> phone-number bindings for the code delivery bot.
# DB_PATH=/root/testgram/bot/codes.db

# RabbitMQ URL (default works with Docker setup)
# Format: amqp://username:password@hostname/
# The backend publishes AppCodeCreatedIntegrationEvent here; the bot consumes it
# and forwards the code to the owner of the phone number.
# RABBITMQ_URL=amqp://test:testgram2024@localhost/

# ========================
# PROXY CONFIGURATION
# ========================

# SOCKS5 or HTTP proxy for bot (leave empty to disable)
# Required if server cannot connect to Telegram directly
# Examples:
# PROXY_URL=socks5://148.253.215.33:1080
# PROXY_URL=http://proxy.example.com:8080
# PROXY_URL=
PROXY_URL=
